APP_NAME=Trovantina
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=trovantina
DB_USERNAME=postgres
DB_PASSWORD=password

SESSION_DRIVER=redis
CACHE_STORE=redis
QUEUE_CONNECTION=redis

REDIS_HOST=redis
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mail
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@trovantina.org"
MAIL_FROM_NAME="${APP_NAME}"

# Frontend
VITE_API_URL=http://localhost:8000/api
VITE_APP_NAME="${APP_NAME}"

# Ports for docker-compose overrides if needed
MAIL_PORT_SMTP=1025
MAIL_PORT_UI=8025
